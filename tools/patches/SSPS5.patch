+ALWAYS_INLINE static uint32_t T32T16(uint32_t color)
+{
+  const uint32_t r = ((color & 0xFFu) >> 3) * 255u / 31u;
+  const uint32_t g = (((color >> 8) & 0xFFu) >> 3) * 255u / 31u;
+  const uint32_t b = (((color >> 16) & 0xFFu) >> 3) * 255u / 31u;
+  return r | (g << 8) | (b << 16) | (color & 0xFF000000u);
+}
