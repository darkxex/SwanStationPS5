+bool GPU_HW::PIS(const BatchVertex* vertices) const
+{
+  const float x1 = vertices[1].x - vertices[0].x;
+  const float y1 = vertices[1].y - vertices[0].y;
+  const float x2 = vertices[2].x - vertices[0].x;
+  const float y2 = vertices[2].y - vertices[0].y;
+  const float u1 = static_cast<float>(vertices[1].u) - static_cast<float>(vertices[0].u);
+  const float v1 = static_cast<float>(vertices[1].v) - static_cast<float>(vertices[0].v);
+  const float u2 = static_cast<float>(vertices[2].u) - static_cast<float>(vertices[0].u);
+  const float v2 = static_cast<float>(vertices[2].v) - static_cast<float>(vertices[0].v);
+  const float xy_area = x1 * y2 - y1 * x2;
+  const float uv_area = u1 * v2 - v1 * u2;
+  if (xy_area == 0.0f || uv_area == 0.0f)
+    return m_batch.sp;
+
+  const float dudy = u2 * x1 - u1 * x2;
+  const float dvdx = v1 * y2 - v2 * y1;
+  return (dudy == 0.0f && dvdx == 0.0f);
+}
+
+void GPU_HW::HLQ(BatchVertex* vertices) const
+{
+  const float max_y = std::max(std::max(vertices[0].y, vertices[1].y), std::max(vertices[2].y, vertices[3].y));
+  const float min_y = std::min(std::min(vertices[0].y, vertices[1].y), std::min(vertices[2].y, vertices[3].y));
+  if ((max_y - min_y) == 1.0f)
+  {
+    vertices[1].v = vertices[0].v;
+    vertices[2].v = vertices[0].v;
+    vertices[3].v = vertices[0].v;
+  }
+}
+
+bool GPU_HW::ELT(BatchVertex* vertices)
+{
+  BatchVertex *vshort, *vlong;
+  bool vertical, horizontal;
+
+  if (m_ldm == 2)
+  {
+    BatchVertex* vcorner;
+    if (vertices[0].u == vertices[1].u && vertices[0].v == vertices[1].v)
+    {
+      vcorner = &vertices[0];
+      vshort = &vertices[1];
+      vlong = &vertices[2];
+    }
+    else if (vertices[1].u == vertices[2].u && vertices[1].v == vertices[2].v)
+    {
+      vcorner = &vertices[1];
+      vshort = &vertices[2];
+      vlong = &vertices[0];
+    }
+    else if (vertices[2].u == vertices[0].u && vertices[2].v == vertices[0].v)
+    {
+      vcorner = &vertices[2];
+      vshort = &vertices[0];
+      vlong = &vertices[1];
+    }
+    else
+    {
+      return false;
+    }
+
+    vertical = ((vcorner->y == vshort->y) && (std::abs(vcorner->x - vshort->x) == 1.0f));
+    horizontal = ((vcorner->x == vshort->x) && (std::abs(vcorner->y - vshort->y) == 1.0f));
+    if (vertical)
+    {
+      if (vshort->x == vlong->x)
+        std::swap(vshort, vcorner);
+      else if (vcorner->x != vlong->x)
+        return false;
+    }
+    else if (horizontal)
+    {
+      if (vshort->y == vlong->y)
+        std::swap(vshort, vcorner);
+      else if (vcorner->y != vlong->y)
+        return false;
+    }
+    else
+    {
+      return false;
+    }
+  }
+  else
+  {
+    BatchVertex *va, *vb, *vc;
+    if (vertices[0].x == vertices[1].x)
+    {
+      va = &vertices[0];
+      vb = &vertices[1];
+      vc = &vertices[2];
+    }
+    else if (vertices[1].x == vertices[2].x)
+    {
+      va = &vertices[1];
+      vb = &vertices[2];
+      vc = &vertices[0];
+    }
+    else if (vertices[2].x == vertices[0].x)
+    {
+      va = &vertices[2];
+      vb = &vertices[0];
+      vc = &vertices[1];
+    }
+    else
+    {
+      return false;
+    }
+
+    vertical = (std::abs(va->x - vc->x) == 1.0f);
+    horizontal = (std::abs(va->y - vb->y) == 1.0f);
+    if (!vertical && !horizontal)
+      return false;
+
+    const BatchVertex* vcorner;
+    if (va->y == vc->y)
+      vcorner = va;
+    else if (vb->y == vc->y)
+      vcorner = vb;
+    else
+      return false;
+
+    BatchVertex* vother = ((vcorner == va) ? vb : va);
+    vshort = horizontal ? vother : vc;
+    vlong = vertical ? vother : vc;
+
+    vshort->u = vcorner->u;
+    vshort->v = vcorner->v;
+  }
+
+  BatchVertex* last = &(vertices[3] = *vlong);
+  last->x = vertical ? vshort->x : vlong->x;
+  last->y = horizontal ? vshort->y : vlong->y;
+
+  AddVertex(vertices[0]);
+  AddVertex(vertices[1]);
+  AddVertex(vertices[2]);
+  AddVertex(*vshort);
+  AddVertex(*vlong);
+  AddVertex(vertices[3]);
+  return true;
+}
