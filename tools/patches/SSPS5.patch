+extern "C" RETRO_API bool retro_ds(const char* path, char* out, size_t size)
+{
+  if (!path || !out || size == 0)
+    return false;
+  std::unique_ptr<CDImage> image = CDImage::Open(path, CDImage::OpenFlags::None, nullptr);
+  if (!image)
+    return false;
+  const std::string code = System::GetGameCodeForImage(image.get(), false);
+  if (code.empty() || code.size() >= size)
+    return false;
+  std::memcpy(out, code.c_str(), code.size() + 1);
+  return true;
+}
