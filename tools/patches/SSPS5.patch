+  }
+
+  uvec2 offset;
+  offset.x = (coords.x < u_base_coords.x)
+             ? (native_size.x - u_base_coords.x + coords.x)
+             : (coords.x - u_base_coords.x);
+  offset.y = (coords.y < u_base_coords.y)
+             ? (native_size.y - u_base_coords.y + coords.y)
