   // UV-clamping path. Pre-UV_LIMITS-routing this was gated by the
   // compile-time UV_LIMITS macro. Now u_uv_limits is a runtime
@@ -263,6 +266,10 @@ void main()
       uv_limits = uv_limits * float(RESOLUTION_SCALE);
       uv_limits.zw += float(RESOLUTION_SCALE - 1u);
     }
+    else if (u_frt != 0u)
+    {
+      uv_limits.zw += vec2(0.5, 0.5);
+    }
     texcol = SampleFromVRAM(v_texpage, clamp(coords, uv_limits.xy, uv_limits.zw));
   }
   else
diff --git a/data/shaders/vulkan/vram_write_bilinear.glslh b/data/shaders/vulkan/vram_write_bilinear.glslh
new file mode 100644
index 00000000..a28cea37
--- /dev/null
+++ b/data/shaders/vulkan/vram_write_bilinear.glslh
@@ -0,0 +1,29 @@
+void FilteredSampleFromVRAM(uvec4 texpage, vec2 coords, vec4 uv_limits,
+                            out vec4 texcol, out float ialpha)
+{
+
+  vec2 texel_top_left = fract(coords) - vec2(0.5, 0.5);
+  vec2 texel_offset   = sign(texel_top_left);
+  vec4 fcoords        = max(coords.xyxy + vec4(0.0, 0.0, texel_offset.x, texel_offset.y),
+                            vec4(0.0, 0.0, 0.0, 0.0));
+
+  vec4 s00 = SampleFromVRAM(texpage, clamp(fcoords.xy, uv_limits.xy, uv_limits.zw));
+  vec4 s10 = SampleFromVRAM(texpage, clamp(fcoords.zy, uv_limits.xy, uv_limits.zw));
+  vec4 s01 = SampleFromVRAM(texpage, clamp(fcoords.xw, uv_limits.xy, uv_limits.zw));
+  vec4 s11 = SampleFromVRAM(texpage, clamp(fcoords.zw, uv_limits.xy, uv_limits.zw));
+
+  float a00 = (any(notEqual(s00, vec4(0.0)))) ? 1.0 : 0.0;
+  float a10 = (any(notEqual(s10, vec4(0.0)))) ? 1.0 : 0.0;
+  float a01 = (any(notEqual(s01, vec4(0.0)))) ? 1.0 : 0.0;
+  float a11 = (any(notEqual(s11, vec4(0.0)))) ? 1.0 : 0.0;
+
+  vec2 weights = abs(texel_top_left);
+  texcol = mix(mix(s00, s10, weights.x), mix(s01, s11, weights.x), weights.y);
+  ialpha = mix(mix(a00, a10, weights.x), mix(a01, a11, weights.x), weights.y);
+
+  if (ialpha > 0.0)
+    texcol.rgb /= vec3(ialpha, ialpha, ialpha);
+
+  if (BINALPHA)
+    ialpha = (ialpha >= 0.5) ? 1.0 : 0.0;
+}
diff --git a/data/shaders/vulkan/vram_write_filter_ssbo.frag.glsl b/data/shaders/vulkan/vram_write_filter_ssbo.frag.glsl
new file mode 100644
index 00000000..d0f9c2ef
--- /dev/null
+++ b/data/shaders/vulkan/vram_write_filter_ssbo.frag.glsl
@@ -0,0 +1,104 @@
+#version 450 core
+#extension GL_GOOGLE_include_directive : require
+
+layout(constant_id = 0) const uint RESOLUTION_SCALE = 1u;
+layout(constant_id = 3) const bool PGXP_DEPTH       = false;
+
+const bool BINALPHA = false;
+
+layout(push_constant) uniform PushConstants {
+  uvec2 u_base_coords;
+  uvec2 u_end_coords;
+  uvec2 u_size;
+  uint  u_buffer_base_offset;
+  uint  u_mask_or_bits;
+  float u_depth_value;
+};
+
+layout(std430, set = 0, binding = 0) readonly restrict buffer SSBO {
+  uint ssbo_data[];
+};
+
+layout(location = 0) in VertexData {
+  vec2 v_tex0;
+};
+
+layout(location = 0) out vec4 o_col0;
+
+vec4 RGBA5551ToRGBA8(uint v)
+{
+  uint r = (v       ) & 31u;
+  uint g = (v >>  5u) & 31u;
+  uint b = (v >> 10u) & 31u;
+  uint a = (v >> 15u) &  1u;
+  return vec4(float(r) / 31.0, float(g) / 31.0, float(b) / 31.0, float(a));
+}
+
+uint FetchValue(uvec2 offset)
+{
+  uint buffer_offset = u_buffer_base_offset + (offset.y * u_size.x) + offset.x;
+  uint packed = ssbo_data[buffer_offset / 2u];
+  uint shift  = (buffer_offset % 2u) * 16u;
+  return (packed >> shift) & 0xFFFFu;
+}
+
+vec4 SampleFromVRAM(uvec4 texpage, vec2 coords)
+{
+  vec2 limit = vec2(u_size) - vec2(1.0, 1.0);
+  uvec2 icoords = uvec2(floor(clamp(coords, vec2(0.0, 0.0), limit)));
+  return vec4(RGBA5551ToRGBA8(FetchValue(icoords)).rgb, 1.0);
+}
+
+#if defined(F_BILINEAR)
+#include "vram_write_bilinear.glslh"
+#elif defined(F_JINC2)
+#include "vram_write_jinc2.glslh"
+#elif defined(F_XBR)
+#include "vram_write_xbr.glslh"
+#elif defined(F_MMPX)
+#include "vram_write_mmpx.glslh"
+#elif defined(F_MMPX30)
+#include "vram_write_mmpx30.glslh"
+#elif defined(F_MMPX32)
+#include "vram_write_mmpx32.glslh"
+#endif
+
+void main()
+{
+  uvec2 VRAM_SIZE   = uvec2(1024u, 512u) * RESOLUTION_SCALE;
+  uvec2 native_size = VRAM_SIZE / RESOLUTION_SCALE;
+
+  uvec2 coords = uvec2(uint(gl_FragCoord.x) / RESOLUTION_SCALE,
+                       uint(gl_FragCoord.y) / RESOLUTION_SCALE);
+
+  if ((coords.x < u_base_coords.x && coords.x >= u_end_coords.x) ||
+      (coords.y < u_base_coords.y && coords.y >= u_end_coords.y))
+  {
+    discard;
+  }
+
+  uvec2 offset;
+  offset.x = (coords.x < u_base_coords.x)
+             ? (native_size.x - u_base_coords.x + coords.x)
+             : (coords.x - u_base_coords.x);
+  offset.y = (coords.y < u_base_coords.y)
+             ? (native_size.y - u_base_coords.y + coords.y)
+             : (coords.y - u_base_coords.y);
+
+  vec4 original_color = RGBA5551ToRGBA8(FetchValue(offset) | u_mask_or_bits);
+
+  vec2 native_coords = gl_FragCoord.xy / float(RESOLUTION_SCALE);
+  uvec2 canonical_coords = coords * RESOLUTION_SCALE;
+  bool canonical = (uvec2(gl_FragCoord.xy) == canonical_coords);
+
+  vec4 filtered_color;
+  float filtered_alpha;
+  FilteredSampleFromVRAM(uvec4(0u), vec2(offset) + fract(native_coords),
+                         vec4(0.0, 0.0, vec2(u_size) - vec2(1.0, 1.0)),
+                         filtered_color, filtered_alpha);
+
+  o_col0 = vec4(canonical ? original_color.rgb : filtered_color.rgb, original_color.a);
+
+  gl_FragDepth = PGXP_DEPTH ? 1.0
+                            : ((o_col0.a == 1.0) ? u_depth_value : 0.0);
+}
