+	vec4 diff = col1 - col2;
+
+	float delta_range = max(diff.r, max(diff.g, diff.b)) - min(diff.r, min(diff.g, diff.b));
+
+	float dot_diff = dot(diff, diff);
+
+	float factor = (delta_range * delta_range) * 2.618034;
+
+	return step(dot_diff, mix(0.75, 0.0, factor));
+}
+
+#define eq(a,b) (a==b)
