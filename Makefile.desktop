# PSXS5 - desktop (Linux/WSL) test build of the frontend + core.
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Same sources as the PS5 app, minus PS5-only files. Run through `make desktop`.
# Needs: libsdl2-dev libcurl4-openssl-dev zlib1g-dev

CC ?= gcc
OUT := build/desktop
CORE := build/core-desktop/libpcsx_rearmed.a
RCHEEVOS := build/rcheevos-desktop/librcheevos.a
SDL_CFLAGS := $(shell sdl2-config --cflags)
SDL_LIBS := $(shell sdl2-config --libs)

SRCS := src/main.c src/util.c src/library.c src/config.c src/cheats.c src/disc.c \
	src/covers.c src/net.c src/stb_impl.c src/ra/achievements.c src/i18n.c src/stats.c src/tips.c src/controls.c src/bezels.c src/art.c src/profiles.c src/gamedb.c src/play.c src/remote.c src/update.c src/vendor.c src/platform/vk/vk_probe.c \
	src/core/host.c src/core/swanstation_options.c src/platform/plat_sdl.c src/platform/blit.c src/platform/xbr.c \
	src/ui/text.c src/ui/draw.c src/ui/sfx.c src/ui/coverflow.c \
	src/ui/icons.c src/ui/settings_screen.c src/ui/menu_screen.c src/ui/memcards_screen.c src/ui/stats_screen.c src/ui/manual_screen.c src/ui/theme.c src/ui/cheat_search.c src/ui/guide_screen.c src/ui/profile_screen.c
OBJS := $(SRCS:src/%.c=$(OUT)/obj/%.o)

CFLAGS += -std=gnu11 -O2 -g -Wall -Wextra -Wno-unused-parameter -DPSXS5_HAVE_CURL=1 \
	-Ithird_party/pcsx_rearmed/deps/libretro-common/include -Ithird_party/stb \
	-Ithird_party/rcheevos/include $(SDL_CFLAGS)

$(OUT)/psxs5: $(OBJS) $(CORE) $(RCHEEVOS)
	$(CC) -o $@ $(OBJS) $(CORE) $(RCHEEVOS) $(SDL_LIBS) -lcurl -lm -lpthread -ldl -lz

# stb is third-party: keep its warnings out of ours
$(OUT)/obj/stb_impl.o: CFLAGS += -w

$(OUT)/obj/%.o: src/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -c $< -o $@

-include $(OBJS:.o=.d)
